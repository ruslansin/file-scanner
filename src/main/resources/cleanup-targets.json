{
  "windows": [
    { "name": "Windows Update Cache",      "path": "%WINDIR%\\SoftwareDistribution\\Download", "description": "Cached Windows Update files. Safe — Windows re-downloads what it needs." },
    { "name": "Windows Update DataStore",  "path": "%WINDIR%\\SoftwareDistribution\\DataStore", "description": "Windows Update history/metadata database. Safe to clear — Windows rebuilds it; stop the 'Windows Update' service first if deletion fails.", "contentsOnly": true, "risk": "high" },
    { "name": "System Temp",                "path": "%WINDIR%\\Temp",                            "description": "Temporary system files", "contentsOnly": true },
    { "name": "User Temp",                  "path": "%TEMP%",                                    "description": "User temporary files", "contentsOnly": true, "daysOld": 1 },
    { "name": "Delivery Optimization",      "path": "%WINDIR%\\DeliveryOptimization",            "description": "P2P update sharing cache", "contentsOnly": true },
    { "name": "CBS Logs",                   "path": "%WINDIR%\\Logs\\CBS",                       "description": "Component servicing logs", "contentsOnly": true },
    { "name": "Thumbnail Cache",            "path": "%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer\\thumbcache_*.db", "description": "Thumbnail cache files", "filesOnly": true },
    { "name": "IE/Edge Cache",              "path": "%LOCALAPPDATA%\\Microsoft\\Windows\\INetCache",    "description": "Internet Explorer / Edge cache", "contentsOnly": true },
    { "name": "Windows.old",                "path": "%SYSTEMDRIVE%\\Windows.old",                "description": "Previous Windows installation kept after an upgrade (normally auto-removed after ~10 days). Often tens of GB; some files may need administrator rights to remove.", "risk": "high" },
    { "name": "Windows Component Store (WinSxS)", "path": "%WINDIR%\\WinSxS", "description": "Servicing component store for Windows Update/DISM. Never delete these files directly — that breaks Windows. Use 'Run' to reclaim space safely via DISM's component cleanup (requires admin, may take a while).", "customCommand": "powershell -NoProfile -Command \"Start-Process Dism.exe -ArgumentList '/Online /Cleanup-Image /StartComponentCleanup' -Verb RunAs\"", "risk": "high", "actionOnly": true },
    { "name": "Hibernation File (hiberfil.sys)",  "path": "%SYSTEMDRIVE%\\hiberfil.sys",         "description": "Reserved space equal to your installed RAM for hibernation/Fast Startup. Use 'Run' to disable hibernation and free this space (re-enable anytime with 'powercfg /hibernate on').", "customCommand": "powershell -NoProfile -Command \"Start-Process powercfg -ArgumentList '/hibernate off' -Verb RunAs\"", "risk": "high", "actionOnly": true }
  ],

  "linux": [
    { "name": "Systemd Journal",            "path": "/var/log/journal",                          "description": "Systemd journal logs", "contentsOnly": true, "risk": "high" },
    { "name": "APT Cache",                  "path": "/var/cache/apt/archives",                   "description": "Downloaded APT packages", "contentsOnly": true },
    { "name": "Snap Cache",                 "path": "/var/lib/snapd/cache",                      "description": "Snap package cache", "contentsOnly": true },
    { "name": "Old /tmp files",             "path": "/tmp",                                      "description": "Files in /tmp older than 3 days only", "contentsOnly": true, "daysOld": 3, "risk": "high" },
    { "name": "Trash",                      "path": "$HOME/.local/share/Trash",                  "description": "User trash", "contentsOnly": true },
    { "name": "User Cache",                 "path": "$XDG_CACHE_HOME",                           "description": "XDG cache directory", "contentsOnly": true },
    { "name": "Log files (*.log)",          "path": "/var/log",                                  "description": "Only *.log files under /var/log — other log formats are left untouched", "extension": ".log", "risk": "high" }
  ],

  "macos": [
    { "name": "User Caches",                "path": "$HOME/Library/Caches",                      "description": "Application caches", "contentsOnly": true },
    { "name": "User Logs",                  "path": "$HOME/Library/Logs",                        "description": "Application logs", "contentsOnly": true },
    { "name": "System Caches",              "path": "/Library/Caches",                           "description": "System caches", "contentsOnly": true, "risk": "high" },
    { "name": "System Logs",                "path": "/Library/Logs",                             "description": "System logs", "contentsOnly": true, "risk": "high" },
    { "name": "Trash",                      "path": "$HOME/.Trash",                              "description": "User trash", "contentsOnly": true },
    { "name": "VS Code Cache",              "path": "$HOME/Library/Application Support/Code/Cache", "description": "VS Code cache", "contentsOnly": true },
    { "name": "Xcode DerivedData",          "path": "$HOME/Library/Developer/Xcode/DerivedData", "description": "Xcode build artifacts" }
  ],

  "developer": [
    { "name": "Maven Repository",           "path": "$HOME/.m2/repository",                      "description": "Local Maven artifacts" },
    { "name": "Gradle Caches",              "path": "$HOME/.gradle/caches",                      "description": "Gradle build cache" },
    { "name": "npm Cache",                  "path": "$HOME/.npm/_cacache",                       "description": "npm package cache" },
    { "name": "pip Cache (linux/mac)",      "path": "$HOME/.cache/pip",   "winPath": "%LOCALAPPDATA%\\pip\\cache",    "description": "pip package cache" },
    { "name": "Cargo Registry",             "path": "$HOME/.cargo/registry/cache",               "description": "Rust crate cache" },
    { "name": "Go Module Cache",            "path": "$HOME/go/pkg/mod",                          "description": "Go module cache" },
    { "name": "NuGet Packages",             "path": "$HOME/.nuget/packages",                     "description": "NuGet package cache" },
    { "name": "Yarn Cache",                 "path": "$HOME/.yarn/cache",     "winPath": "%LOCALAPPDATA%\\Yarn\\cache", "description": "Yarn package cache" },
    { "name": "Composer Cache",             "path": "$HOME/.composer/cache",                     "description": "PHP Composer cache" },
    { "name": "RubyGems Cache",             "path": "$HOME/.gem/cache",                          "description": "Ruby gem cache" },
    { "name": "Docker BuildKit",            "path": "$HOME/.docker/buildkit",                    "description": "Docker BuildKit cache (also shown, more reliably, in the Docker panel above via 'docker system df')" },
    { "name": "Docker Desktop WSL disk",    "winPath": "%LOCALAPPDATA%\\Docker\\wsl",                "description": "Docker Desktop WSL2 virtual disk" },
    { "name": "Docker Desktop config",      "winPath": "%APPDATA%\\Docker",                          "description": "Docker Desktop config and metadata" },
    { "name": "Docker Desktop VM disk",     "macPath": "$HOME/Library/Containers/com.docker.docker/Data", "description": "Docker Desktop VM data" },
    { "name": "Conda Packages",             "path": "$HOME/miniconda3/pkgs",                     "description": "Miniconda package cache" },
    { "name": "Anaconda Packages",          "path": "$HOME/anaconda3/pkgs",                      "description": "Anaconda package cache" },
    { "name": "Homebrew Cache (macOS)",     "path": "$HOME/Library/Caches/Homebrew",             "description": "Homebrew formula cache" },
    { "name": "Android SDK Cache",          "path": "$HOME/.android/cache",                      "description": "Android SDK cache" }
  ],

  "buildArtifacts": [
    { "name": "node_modules" },
    { "name": "target" },
    { "name": "build" },
    { "name": ".gradle" },
    { "name": "__pycache__" },
    { "name": "dist" },
    { "name": ".next" },
    { "name": "vendor" },
    { "name": ".venv" },
    { "name": "venv" },
    { "name": ".nuxt" },
    { "name": ".output" },
    { "name": "bin" },
    { "name": "obj" },
    { "name": ".pytest_cache" }
  ],

  "scanRoots": [
    "$HOME/dev",
    "$HOME/projects",
    "$HOME/git",
    "$HOME/IdeaProjects"
  ]
}
